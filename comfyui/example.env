# Copy to .env and fill in. chmod 600. Never commit.
# The key must belong to a Google Cloud project with billing enabled —
# image models have a free-tier limit of exactly 0, so a key from an
# unbilled project returns 429 no matter how much credit you prepay.
GEMINI_API_KEY=

# Tailscale IP of this host (`tailscale ip -4`). ComfyUI has NO authentication,
# so it is published on the tailnet interface only — never 0.0.0.0.
TS_IP=

# Optional. Without it, Civitai restricted models return an HTML error page
# instead of weights — `comfy pull` detects and discards those rather than
# leaving a webpage on disk under a .safetensors name.
CIVITAI_TOKEN=
