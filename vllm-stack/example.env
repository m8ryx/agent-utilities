# Copy to .env and fill in. chmod 600. Never commit.

# Tailscale IP of this host (`tailscale ip -4`). LiteLLM binds here rather
# than 0.0.0.0 so the proxy is reachable on the tailnet but not the LAN.
TS_IP=

# Shared secret between LiteLLM and vLLM. Any random string.
VLLM_API_KEY=

# LiteLLM admin key. Must start with "sk-". Generate virtual keys from this
# via POST /key/generate rather than handing it to clients directly.
LITELLM_MASTER_KEY=sk-

# Must be scoped to a workspace. An org-level key fails with
# "This API key is not scoped to a workspace" unless you also send an
# anthropic-workspace-id header.
ANTHROPIC_API_KEY=

# Optional. Only needed for gated HuggingFace repos.
HF_TOKEN=

# Postgres password for LiteLLM's state database.
POSTGRES_PASSWORD=
